DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LangSmith (for Studio login + Tracing)
# Get your key at https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=deepagent-practice

# 注意：API Key 现在会持久化到用户数据目录（data_dir/config.json），
# 升级或更换运行目录都不会丢失。也可以直接在 CLI 中用 /key 命令设置。
# 以下 .env 仅作为初始配置/环境变量使用，首次运行会自动迁移。
# Agent runtime and persistence
AGENT_RECURSION_LIMIT=100
AGENT_MAX_EXECUTION_TIME=600
AGENT_THREAD_ID=default
CHECKPOINT_DB=checkpoints.sqlite
# AI_FRONTIER_HOME=C:\Users\you\AppData\Local\ai-frontier-explorer
# 报告输出目录（可单独覆盖；留空则默认 <data_dir>/reports）
# REPORTS_DIR=D:\MyReports\papers
